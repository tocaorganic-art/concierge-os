{
  "name": "Sync Tarefas Google Agenda",
  "description": "Cria, atualiza e remove automaticamente eventos no Google Agenda quando tarefas s\u00e3o criadas, alteradas ou exclu\u00eddas no Concierge OS",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Task",
      "events": [
        "create",
        "update",
        "delete"
      ]
    },
    "condition": "${ .trigger.event_type != \"update\" or ((.trigger.changed_fields // []) | length > 1) or ((.trigger.changed_fields // []) | index(\"calendar_event_id\") == null) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "task_calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_event": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncTaskToCalendar",
            "args": {
              "event_type": "${ .trigger.event_type }",
              "entity_id": "${ .trigger.entity_id }",
              "task": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar no Google Agenda",
            "description": "Cria, atualiza ou exclui o evento"
          }
        }
      }
    ]
  }
}