{
  "name": "Task",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da tarefa"
    },
    "horario": {
      "type": "string",
      "description": "Hor\u00e1rio da tarefa (HH:mm)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da tarefa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "chamada",
        "visita",
        "proposta",
        "operacao"
      ],
      "description": "Tipo da tarefa"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente vinculado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_progresso",
        "concluido"
      ],
      "default": "pendente",
      "description": "Status da tarefa. 'em_progresso' foi adicionado para o modal de eventos (Agenda) — 'pendente' e 'concluido' continuam com o mesmo significado de antes."
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Prioridade da tarefa"
    },
    "lembrete_antecedencia": {
      "type": "string",
      "enum": [
        "15min",
        "30min",
        "1h",
        "1dia"
      ],
      "description": "Com quanto de anteced\u00eancia lembrar"
    },
    "lembrete_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o lembrete est\u00e1 ativo"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "ID do evento vinculado no Google Agenda"
    },
    "visivel_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Se esta tarefa aparece na Agenda do cliente vinculado (roteiro da viagem: check-in/out, transfers, vistoria). Default false — alertas e acoes internas (negociar com fornecedor, autorizacao, etc.) nunca ficam visiveis ao cliente."
    },
    "mensagem_rascunho": {
      "type": "string",
      "description": "Rascunho de mensagem para o Tony copiar e enviar manualmente por fora do sistema. Nunca enviado automaticamente, nunca visivel ao cliente.",
      "rls": {
        "read": {
          "user_condition": { "role": "admin" }
        }
      }
    },
    "fotos": {
      "type": "array",
      "default": [],
      "description": "Evidencias fotograficas do evento/operacao (ex.: foto do relogio de energia na vistoria). Cada item: {url, legenda, timestamp}.",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "legenda": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "comentarios": {
      "type": "array",
      "default": [],
      "description": "Thread de comentarios internos da equipe sobre o evento. Cada item: {autor_id, autor_nome, texto, timestamp}.",
      "items": {
        "type": "object",
        "properties": {
          "autor_id": { "type": "string" },
          "autor_nome": { "type": "string" },
          "texto": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "checklist": {
      "type": "array",
      "default": [],
      "description": "Sub-tarefas do evento (ex.: vistoria = tirar foto do medidor, anotar leitura, assinar termo). Cada item: {id, titulo, concluido, timestamp}.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "concluido": { "type": "boolean" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do usuario da equipe responsavel por executar este evento/operacao. Default: quem criou a tarefa."
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do responsavel, guardado junto para nao precisar de join ao listar."
    },
    "editado_em": {
      "type": "string",
      "description": "Timestamp ISO da ultima edicao do evento (qualquer campo do modal de eventos)."
    },
    "editado_por_id": {
      "type": "string",
      "description": "ID do usuario que fez a ultima edicao."
    },
    "editado_por_nome": {
      "type": "string",
      "description": "Nome do usuario que fez a ultima edicao."
    },
    "historico": {
      "type": "array",
      "default": [],
      "description": "Timeline de mudancas do evento. Cada item: {tipo, campo, valor_anterior, valor_novo, usuario_id, usuario_nome, timestamp}.",
      "items": {
        "type": "object",
        "properties": {
          "tipo": { "type": "string" },
          "campo": { "type": "string" },
          "valor_anterior": { "type": "string" },
          "valor_novo": { "type": "string" },
          "usuario_id": { "type": "string" },
          "usuario_nome": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "equipe"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            { "data.client_id": "{{user.data.client_id}}" },
            { "data.visivel_cliente": true }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}