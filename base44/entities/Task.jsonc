{
  "name": "Task",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da tarefa"
    },
    "horario": {
      "type": "string",
      "description": "Hor\u00e1rio da tarefa (HH:mm)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da tarefa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "chamada",
        "visita",
        "proposta",
        "operacao"
      ],
      "description": "Tipo da tarefa"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente vinculado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "concluido"
      ],
      "default": "pendente",
      "description": "Status da tarefa"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Prioridade da tarefa"
    },
    "lembrete_antecedencia": {
      "type": "string",
      "enum": [
        "15min",
        "30min",
        "1h",
        "1dia"
      ],
      "description": "Com quanto de anteced\u00eancia lembrar"
    },
    "lembrete_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o lembrete est\u00e1 ativo"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}