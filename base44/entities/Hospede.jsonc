{
  "name": "Hospede",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "ID da proposta/evento a que este hospede pertence."
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente contratante — usado para o cliente contratante ver nome/voo deste hospede (RLS abaixo), mesmo que o hospede nao seja ele proprio."
    },
    "nome": {
      "type": "string",
      "description": "Primeiro nome do hospede."
    },
    "sobrenome": {
      "type": "string",
      "description": "Sobrenome do hospede."
    },
    "documento": {
      "type": "string",
      "description": "Numero de documento (DNI/CPF/passaporte). O cliente contratante pode preencher (RLS de update abaixo), mas nunca le de volta — nem o proprio nem o de outro hospede.",
      "rls": {
        "read": {
          "user_condition": { "role": "admin" }
        },
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "data_chegada": { "type": "string", "format": "date" },
    "voo_chegada": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "horario_chegada": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "aerolinea_chegada": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "data_saida": { "type": "string", "format": "date" },
    "voo_saida": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "horario_saida": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "aerolinea_saida": {
      "type": "string",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "pernoita_em": {
      "type": "string",
      "enum": ["casa", "apartamento"],
      "description": "Onde este hospede dorme, quando o grupo excede o limite de 15 pernoitando na casa. Preenchivel pelo cliente contratante.",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    },
    "documento_preenchido": {
      "type": "boolean",
      "default": false,
      "description": "Se documento ja foi preenchido - so um sinalizador (nunca o valor), atualizado junto com documento no mesmo update. Permite mostrar 'faltam X documentos' pro cliente sem expor nenhum documento real (leitura normal, nao e o campo documento em si).",
      "rls": {
        "update": {
          "$or": [
            { "created_by_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "data.client_id": "{{user.data.client_id}}" }
          ]
        }
      }
    }
  },
  "required": ["nome"],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "account_type": "equipe" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
        { "data.client_id": "{{user.data.client_id}}" }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
