{
  "name": "Client",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "familia",
        "casal",
        "grupo",
        "vip",
        "corporativo"
      ],
      "description": "Tipo de cliente"
    },
    "origem": {
      "type": "string",
      "description": "Como o cliente chegou (indica\u00e7\u00e3o, instagram, site, etc)"
    },
    "notas": {
      "type": "string",
      "description": "Notas e prefer\u00eancias do cliente"
    },
    "valor_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total gasto pelo cliente"
    }
  },
  "required": [
    "nome"
  ]
}