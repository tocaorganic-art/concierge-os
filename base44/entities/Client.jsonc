{
  "name": "Client",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "familia",
        "casal",
        "grupo",
        "vip",
        "corporativo"
      ],
      "description": "Tipo de cliente"
    },
    "origem": {
      "type": "string",
      "description": "Como o cliente chegou"
    },
    "notas": {
      "type": "string",
      "description": "Notas e prefer\u00eancias do cliente"
    },
    "valor_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total gasto"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}