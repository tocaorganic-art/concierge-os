{
  "name": "Client",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "familia",
        "casal",
        "grupo",
        "vip",
        "corporativo"
      ],
      "description": "Tipo de cliente"
    },
    "origem": {
      "type": "string",
      "description": "Como o cliente chegou"
    },
    "notas": {
      "type": "string",
      "description": "Notas e prefer\u00eancias do cliente"
    },
    "valor_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total gasto"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "enabled": true,
    "rules": {
      "select": {
        "filter": "created_by_id = auth.uid() OR auth.role = 'admin'"
      },
      "insert": {
        "check": "created_by_id = auth.uid()"
      },
      "update": {
        "filter": "created_by_id = auth.uid() OR auth.role = 'admin'"
      },
      "delete": {
        "filter": "created_by_id = auth.uid() OR auth.role = 'admin'"
      }
    }
  }
}