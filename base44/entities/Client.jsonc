{
  "name": "Client",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "familia",
        "casal",
        "grupo",
        "vip",
        "corporativo"
      ],
      "description": "Tipo de cliente"
    },
    "origem": {
      "type": "string",
      "description": "Como o cliente chegou"
    },
    "notas": {
      "type": "string",
      "description": "Notas e prefer\u00eancias do cliente"
    },
    "valor_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total gasto"
    },
    "cor_classificacao": {
      "type": "string",
      "enum": [
        "vermelho",
        "laranja",
        "amarelo",
        "verde",
        "azul",
        "roxo",
        "rosa",
        "cinza"
      ],
      "description": "Cor escolhida manualmente pela equipe para classificar este cliente (uso livre — ex.: prioridade, tipo de relacionamento). Sem relacao com a cor automatica por hash usada em outras telas."
    },
    "idioma_padrao": {
      "type": "string",
      "enum": ["pt-BR", "es", "en"],
      "description": "Idioma padrao do Portal do Cliente na primeira visita (ex.: grupo argentino em espanhol). So se aplica se o cliente ainda nao tiver escolhido um idioma manualmente; depois disso, a escolha dele prevalece."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "equipe"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}