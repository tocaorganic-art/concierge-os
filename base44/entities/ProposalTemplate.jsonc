{
  "name": "ProposalTemplate",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do template (ex.: Villa Trancoso 6 noites, Casal Maldivas)."
    },
    "destino": {
      "type": "string",
      "description": "Destino padr\u00e3o deste template (opcional \u2014 preenchido na proposta se estiver vazio)."
    },
    "servicos": {
      "type": "string",
      "description": "Servi\u00e7os inclu\u00eddos padr\u00e3o (hotel, transfers, passeios, roteiro dia a dia etc.)."
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es padr\u00e3o que acompanham esta estrutura de proposta."
    },
    "valor_base": {
      "type": "number",
      "description": "Valor base sugerido para este template (preenchido na proposta como ponto de partida)."
    },
    "num_pax": {
      "type": "number",
      "description": "N\u00ba de passageiros padr\u00e3o deste template (opcional)."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "equipe"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}