{
  "name": "Expense",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente/evento vinculado"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "proposal_id": {
      "type": "string",
      "description": "ID da proposta/evento vinculado (opcional)"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da despesa \u2014 livre, n\u00e3o fixa. Ex: Im\u00f3vel, Equipe/Pessoal, Transporte, Compras, Festas, Aluguel de Som, DJ, Churrasqueiro, Massagista, Outros. Se a categoria certa n\u00e3o existir ainda, cria-se uma nova (manual ou via IA)."
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da despesa"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor, prestador ou pessoa paga"
    },
    "valor": {
      "type": "number",
      "description": "Valor real pago/gasto, conforme comprovante (o que efetivamente saiu do seu bolso)"
    },
    "valor_cobrado_cliente": {
      "type": "number",
      "description": "Valor cheio (pre\u00e7o cheio) cobrado do cliente por este item, quando h\u00e1 repasse com markup \u2014 este \u00e9 o valor que aparece para equipe/cliente. Deixe em branco quando n\u00e3o houver repasse com margem."
    },
    "margem_admin": {
      "type": "number",
      "description": "Quanto voc\u00ea (admin master) realmente ganhou nessa negocia\u00e7\u00e3o \u2014 sua margem/comiss\u00e3o real. Campo de uso exclusivo do admin master; nunca \u00e9 exposto para equipe ou cliente."
    },
    "data_despesa": {
      "type": "string",
      "format": "date",
      "description": "Data da despesa/pagamento"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL da foto/comprovante (nota fiscal, recibo, pix)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "manual",
        "ia_nota_fiscal"
      ],
      "default": "manual",
      "description": "Se o lan\u00e7amento foi manual ou extra\u00eddo por IA a partir do comprovante"
    }
  },
  "required": [
    "client_nome",
    "categoria",
    "valor"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}