{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "experiencia",
        "reserva",
        "exclusivo",
        "ajuda"
      ],
      "description": "Tipo de solicita\u00e7\u00e3o do cliente"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo resumido da solicita\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do pedido"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "em_andamento",
        "resolvido",
        "cancelado"
      ],
      "default": "novo",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal",
      "description": "Prioridade da solicita\u00e7\u00e3o"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "destino": {
      "type": "string",
      "description": "Destino/local da solicita\u00e7\u00e3o"
    },
    "data_desejada": {
      "type": "string",
      "format": "date",
      "description": "Data desejada pelo cliente"
    },
    "resposta_concierge": {
      "type": "string",
      "description": "Resposta/resolu\u00e7\u00e3o do concierge"
    },
    "plano_cliente": {
      "type": "string",
      "enum": [
        "essencial",
        "premium",
        "black"
      ],
      "description": "Plano do cliente"
    }
  },
  "required": [
    "tipo",
    "titulo",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}