{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "equipe",
        "cliente"
      ],
      "default": "equipe",
      "description": "Tipo de acesso: equipe (colaborador interno) ou cliente (acesso restrito ao Portal do Cliente)"
    },
    "client_id": {
      "type": "string",
      "description": "Quando account_type = cliente: ID do registro Client ao qual este login est\u00e1 vinculado"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "pt-BR",
        "en",
        "es"
      ],
      "description": "Idioma preferido do usu\u00e1rio, salvo ao trocar o idioma no app. Serve de fallback entre dispositivos/sess\u00f5es, complementando o localStorage (que \u00e9 por navegador)."
    }
  },
  "required": [
    "role"
  ]
}