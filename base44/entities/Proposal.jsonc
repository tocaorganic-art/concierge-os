{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "destino": {
      "type": "string",
      "description": "Destino da viagem"
    },
    "data_chegada": {
      "type": "string",
      "format": "date",
      "description": "Data de chegada"
    },
    "data_saida": {
      "type": "string",
      "format": "date",
      "description": "Data de sa\u00edda"
    },
    "num_pax": {
      "type": "number",
      "description": "N\u00famero de passageiros"
    },
    "valor": {
      "type": "number",
      "description": "Valor estimado da proposta"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "proposta",
        "confirmado",
        "concluido",
        "cancelado"
      ],
      "default": "lead",
      "description": "Status da proposta no pipeline"
    },
    "etapa_jornada": {
      "type": "number",
      "default": 1,
      "description": "Etapa atual da 'Jornada da viagem' (1=Proposta recebida, 2=Destino confirmado, 3=Preparativos, 4=Tudo pronto, 5=Viagem concluida). Definida EXCLUSIVAMENTE pelo admin no painel da Visao Geral \u2014 nunca e derivada de datas, pagamentos ou tempo. Ausente/invalido em registros antigos = etapa 1."
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Ate quando esta proposta (status lead ou proposta) fica valida antes de ser considerada expirada. Sem efeito quando o status ja e confirmado, concluido ou cancelado."
    },
    "servicos": {
      "type": "string",
      "description": "Servi\u00e7os inclu\u00eddos na proposta"
    },
    "itens_contrato": {
      "type": "array",
      "description": "Itens do contrato assinado, com o preco cheio de cada um (ex.: Hospedagem exclusiva R$68.000 + Toca Concierge R$15.000 + Roteiro incluido = R$83.000) - dados publicos do proprio contrato do cliente, visiveis a ele (mesma visibilidade da proposta). Diferente de Billing.alocacao (custo/margem internos, admin-only) - isto e so a composicao do preco que ele ja assinou.",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "incluido": {
            "type": "boolean",
            "description": "Se true, mostra 'incluido' em vez de um valor (ex.: Roteiro incluido no pacote)."
          }
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da proposta"
    },
    "contrato_assinado_url": {
      "type": "string",
      "description": "URL do PDF/imagem do contrato assinado da casa, exibido integralmente na pagina \"Meu Contrato\" do cliente. Upload feito pelo admin (mesma RLS de update da entidade); visivel ao cliente vinculado (mesma visibilidade da proposta)."
    },
    "contrato_dados_extraidos": {
      "type": "object",
      "description": "Dados estruturados lidos por IA do contrato_assinado_url (Fase 3) - cliente/documento, checkin/checkout, valor total, parcelas, deposito de garantia, custos extras, servicos incluidos e data de assinatura. Preenchido so apos confirmacao explicita do admin na tela de leitura do contrato; nunca escrito sozinho. Uso interno (RLS abaixo) - o cliente ja ve o PDF original em Meu Contrato, este campo e so pra alimentar o preenchimento automatico e os alertas.",
      "properties": {
        "cliente_nome": { "type": "string" },
        "documento_identidade": { "type": "string" },
        "propriedade_destino": { "type": "string" },
        "checkin_data": { "type": "string", "format": "date" },
        "checkin_hora": { "type": "string" },
        "checkout_data": { "type": "string", "format": "date" },
        "checkout_hora": { "type": "string" },
        "valor_total": { "type": "number" },
        "parcelas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "descricao": { "type": "string" },
              "valor": { "type": "number" },
              "data_vencimento": { "type": "string", "format": "date" }
            }
          }
        },
        "deposito_garantia_valor": { "type": "number" },
        "deposito_garantia_condicao": { "type": "string" },
        "custos_extras": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "descricao": { "type": "string" },
              "valor": { "type": "number" }
            }
          }
        },
        "servicos_incluidos": { "type": "string" },
        "data_assinatura": { "type": "string", "format": "date" },
        "lido_em": { "type": "string", "description": "Timestamp ISO de quando esta leitura foi confirmada." }
      },
      "rls": {
        "read": {
          "user_condition": { "role": "admin" }
        }
      }
    },
    "documentos_cliente": {
      "type": "array",
      "description": "Documentos visiveis ao cliente vinculado (contrato/adendo assinado, vouchers) - mesma visibilidade da proposta em si, sem RLS de campo adicional.",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          }
        }
      }
    },
    "documentos_admin": {
      "type": "array",
      "description": "Documentos de uso exclusivo admin/equipe (contratos de fornecedor sem lugar proprio, listas de hospedes, meios de pagamento internos). Nunca exposto ao cliente.",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          }
        }
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "forma_pagamento_preferida": {
      "type": "string",
      "enum": [
        "pix_pj_cora",
        "pix_cpf_tony"
      ],
      "default": "pix_pj_cora",
      "description": "Qual conta de recebimento mostrar ao cliente em \"Como pagar\". pix_pj_cora = QR/chave da empresa (padrao atual). pix_cpf_tony = usa o campo chave_pix_recebimento abaixo."
    },
    "chave_pix_recebimento": {
      "type": "string",
      "description": "Chave Pix de recebimento deste contrato (nao e credencial - ja consta no contrato assinado com o cliente). Editavel so pelo admin (update da entidade ja restringe); visivel ao cliente vinculado em \"Como pagar\" quando forma_pagamento_preferida = pix_cpf_tony."
    },
    "alertas_contratuais": {
      "type": "array",
      "description": "Alertas operacionais/financeiros derivados de clausulas do contrato deste evento (capacidade, checkout, restricoes de barulho, risco fiscal etc.) - uso exclusivo admin, entrada manual por ora (nao ha motor generico de clausulas ainda).",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "valor_estimado": {
            "type": "number"
          }
        }
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "versoes_anteriores": {
      "type": "array",
      "description": "Historico de versoes anteriores desta proposta (ex.: valor negociado antes de um adendo final) - uso exclusivo admin, nunca exposto ao cliente.",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "valor": {
            "type": "number"
          },
          "resumo": {
            "type": "string"
          }
        }
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "client_nome",
    "destino",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "equipe"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}