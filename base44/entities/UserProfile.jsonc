{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (refer\u00eancia ao User) \u2014 pode ficar vazio at\u00e9 o primeiro login quando criado por convite"
    },
    "plan_id": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "pro",
        "agency"
      ],
      "default": "trial",
      "description": "Plano atual do usu\u00e1rio"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do trial"
    },
    "business_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o/neg\u00f3cio"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade do operador"
    },
    "preferred_currency": {
      "type": "string",
      "enum": [
        "BRL",
        "USD",
        "EUR"
      ],
      "default": "BRL",
      "description": "Moeda preferida"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo white-label"
    },
    "whatsapp_concierge": {
      "type": "string",
      "description": "Numero de WhatsApp do concierge (com DDI), mostrado ao cliente no Portal e no email de boas-vindas como contato direto. Ex.: +55 73 99999-9999."
    },
    "primary_color": {
      "type": "string",
      "description": "Cor prim\u00e1ria white-label"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "ID do cliente no Stripe"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "incomplete"
      ],
      "description": "Status da assinatura no Stripe"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim do trial"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Price ID ativo no Stripe"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "equipe",
        "cliente"
      ],
      "default": "equipe",
      "description": "Tipo de acesso deste usu\u00e1rio dentro da conta: equipe (colaborador interno) ou cliente (acesso restrito ao Portal do Cliente)"
    },
    "client_id": {
      "type": "string",
      "description": "Quando account_type = cliente: ID do registro Client ao qual este login est\u00e1 vinculado"
    },
    "invite_email": {
      "type": "string",
      "description": "Email usado no convite, para vincular este perfil ao usu\u00e1rio real no primeiro login (quando o perfil \u00e9 criado antes de a pessoa aceitar o convite)"
    }
  },
  "required": [
    "user_id",
    "plan_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.invite_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.invite_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}