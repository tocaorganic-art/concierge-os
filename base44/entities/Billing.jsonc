{
  "name": "Billing",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "proposal_id": {
      "type": "string",
      "description": "ID da proposta/evento vinculado (opcional) — usado para agrupar as parcelas de um mesmo pacote e calcular \"Parcela X de Y\" de forma estruturada, em vez de depender de texto livre na descricao."
    },
    "numero_parcela": {
      "type": "number",
      "description": "Numero desta parcela dentro do parcelamento (1, 2, 3...). Deixe em branco para uma cobranca avulsa (nao parcelada)."
    },
    "total_parcelas": {
      "type": "number",
      "description": "Total de parcelas deste parcelamento. Junto com numero_parcela, permite mostrar \"Parcela 2 de 3\" e validar que a soma das parcelas bate com o valor total da proposta."
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da cobran\u00e7a"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da cobran\u00e7a \u2014 livre, n\u00e3o fixa. 'Contas a Pagar': cobran\u00e7as adicionais normais que o cliente deve pagar (som, passagem, aluguel de carro, apartamento extra, etc. \u2014 qualquer custo repassado fora do pacote principal). 'Reserva Financeira': APENAS cr\u00e9dito real \u2014 dep\u00f3sito que o cliente faz para refor\u00e7ar uma reserva/fundo de garantia, ou saldo que sobra de algum item e vira cr\u00e9dito dele. Nunca usar 'Reserva Financeira' para uma cobran\u00e7a a receber \u2014 isso \u00e9 'Contas a Pagar'. Se a categoria certa n\u00e3o existir ainda, cria-se uma nova."
    },
    "valor": {
      "type": "number",
      "description": "Valor da cobran\u00e7a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "parcialmente_recebido",
        "recebido",
        "atrasado",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status derivado do saldo (ver src/lib/finance.js) — nao editar manualmente exceto 'cancelado', que exige motivo_cancelamento. pendente: nada recebido. parcialmente_recebido: 0 < recebido < valor. recebido: saldo zerado. atrasado: saldo>0 e hoje>vencimento. cancelado: motivo obrigatorio."
    },
    "motivo_cancelamento": {
      "type": "string",
      "description": "Obrigatorio quando status=cancelado. Cobranca cancelada nunca e apagada, so marcada."
    },
    "natureza": {
      "type": "string",
      "enum": [
        "honorario",
        "intermediacao",
        "comissao",
        "repasse",
        "caucao",
        "a_classificar"
      ],
      "default": "a_classificar",
      "description": "honorario = taxa de concierge cobrada do cliente. intermediacao = diferenca entre preco cobrado do cliente e custo do fornecedor, por item (tambem receita propria). comissao = valor que o proprio fornecedor paga ao Tony (receita propria, distinta de intermediacao). repasse = parte do valor cobrado do cliente que corresponde ao custo do fornecedor, nao e receita. caucao = deposito devolvivel do cliente, nao e receita nem repasse definitivo. a_classificar = registros antigos ainda nao classificados, ou natureza ambigua a confirmar."
    },
    "alocacao": {
      "type": "array",
      "description": "Divisao opcional de um Billing misto (preco cheio) em partes por natureza — ex.: uma parcela de aluguel que contem repasse ao proprietario + intermediacao + honorario embutidos. Soma das partes deve bater com 'valor'. Uso exclusivo do admin; nunca exposto ao cliente (RLS de campo abaixo). Quando ausente, o campo 'natureza' acima classifica o Billing inteiro.",
      "items": {
        "type": "object",
        "properties": {
          "natureza": {
            "type": "string",
            "enum": ["honorario", "intermediacao", "comissao", "repasse", "caucao"]
          },
          "valor": {
            "type": "number"
          }
        }
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "moeda": {
      "type": "string",
      "enum": [
        "BRL",
        "USD",
        "ARS"
      ],
      "default": "BRL",
      "description": "Moeda do contrato. BRL na esmagadora maioria dos casos."
    },
    "valor_original": {
      "type": "number",
      "description": "Valor na moeda original quando moeda != BRL (o campo 'valor' sempre fica em BRL, convertido pela taxa_cambio abaixo)."
    },
    "taxa_cambio": {
      "type": "number",
      "description": "Taxa de cambio usada para converter valor_original para BRL, quando aplicavel."
    },
    "data_cambio": {
      "type": "string",
      "format": "date",
      "description": "Data em que a taxa_cambio foi obtida/aplicada."
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento efetivo"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL da foto/comprovante desta cobran\u00e7a (nota fiscal, or\u00e7amento, print de passagem, recibo de pagamento etc.) \u2014 vis\u00edvel para admin, equipe e para o cliente vinculado a esta cobran\u00e7a. O cliente pode anexar seu pr\u00f3prio comprovante de pagamento no Portal do Cliente (RLS de campo abaixo), sem poder alterar valor, status ou qualquer outro campo da cobran\u00e7a.",
      "rls": {
        "update": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        }
      }
    },
    "ultima_edicao_por": {
      "type": "string",
      "enum": [
        "equipe",
        "cliente"
      ],
      "description": "Quem fez a ultima edicao visivel deste registro (ex: anexar comprovante) \u2014 usado so para destacar no painel do admin quando foi o proprio cliente, nunca para controle de acesso.",
      "rls": {
        "update": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        }
      }
    }
  },
  "required": [
    "client_nome",
    "valor",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "equipe"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}