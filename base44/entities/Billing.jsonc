{
  "name": "Billing",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da cobran\u00e7a"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da cobran\u00e7a \u2014 livre, n\u00e3o fixa. Ex: Pacote Principal, Reserva Financeira (cobran\u00e7as adicionais cobertas por reserva/cr\u00e9dito que o cliente mant\u00e9m com voc\u00ea \u2014 som, passagem, apartamento extra, etc. \u2014 e tamb\u00e9m dep\u00f3sitos que o cliente faz para refor\u00e7ar essa reserva). Se a categoria certa n\u00e3o existir ainda, cria-se uma nova."
    },
    "valor": {
      "type": "number",
      "description": "Valor da cobran\u00e7a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "recebido",
        "atrasado"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento efetivo"
    }
  },
  "required": [
    "client_nome",
    "valor",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}