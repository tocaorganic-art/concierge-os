{
  "name": "Billing",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "client_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "proposal_id": {
      "type": "string",
      "description": "ID da proposta/evento vinculado (opcional) — usado para agrupar as parcelas de um mesmo pacote e calcular \"Parcela X de Y\" de forma estruturada, em vez de depender de texto livre na descricao.",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "numero_parcela": {
      "type": "number",
      "description": "Numero desta parcela dentro do parcelamento (1, 2, 3...). Deixe em branco para uma cobranca avulsa (nao parcelada)."
    },
    "total_parcelas": {
      "type": "number",
      "description": "Total de parcelas deste parcelamento. Junto com numero_parcela, permite mostrar \"Parcela 2 de 3\" e validar que a soma das parcelas bate com o valor total da proposta."
    },
    "descricao": {
      "type": "string",
      "description": "Descrição da cobrança",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da cobrança — livre, não fixa. 'Contas a Pagar': cobranças adicionais normais que o cliente deve pagar (som, passagem, aluguel de carro, apartamento extra, etc. — qualquer custo repassado fora do pacote principal). 'Reserva Financeira': APENAS crédito real — depósito que o cliente faz para reforçar uma reserva/fundo de garantia, ou saldo que sobra de algum item e vira crédito dele. Nunca usar 'Reserva Financeira' para uma cobrança a receber — isso é 'Contas a Pagar'. Se a categoria certa não existir ainda, cria-se uma nova.",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "valor": {
      "type": "number",
      "description": "Valor da cobrança",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "tipo_despesa": {
      "type": "string",
      "enum": [
        "fixa",
        "variavel"
      ],
      "default": "variavel",
      "description": "fixa = valor recorrente ou previsto em contrato (ex.: aluguel/contrato da casa). variavel = servico adicional ou cobranca que varia durante a estadia. Caucao continua identificada por natureza='caucao', independente deste campo."
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "parcialmente_recebido",
        "recebido",
        "atrasado",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status derivado do saldo (ver src/lib/finance.js) — nao editar manualmente exceto 'cancelado', que exige motivo_cancelamento. pendente: nada recebido. parcialmente_recebido: 0 < recebido < valor. recebido: saldo zerado. atrasado: saldo>0 e hoje>vencimento. cancelado: motivo obrigatorio.",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            }
          ]
        }
      }
    },
    "motivo_cancelamento": {
      "type": "string",
      "description": "Obrigatorio quando status=cancelado. Cobranca cancelada nunca e apagada, so marcada.",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            }
          ]
        }
      }
    },
    "natureza": {
      "type": "string",
      "enum": [
        "honorario",
        "intermediacao",
        "comissao",
        "repasse",
        "caucao",
        "a_classificar"
      ],
      "default": "a_classificar",
      "description": "honorario = taxa de concierge cobrada do cliente. intermediacao = diferenca entre preco cobrado do cliente e custo do fornecedor, por item (tambem receita propria). comissao = valor que o proprio fornecedor paga ao Tony (receita propria, distinta de intermediacao). repasse = parte do valor cobrado do cliente que corresponde ao custo do fornecedor, nao e receita. caucao = deposito devolvivel do cliente, nao e receita nem repasse definitivo. a_classificar = registros antigos ainda nao classificados, ou natureza ambigua a confirmar.",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "alocacao": {
      "type": "array",
      "description": "Divisao opcional de um Billing misto (preco cheio) em partes por natureza — ex.: uma parcela de aluguel que contem repasse ao proprietario + intermediacao + honorario embutidos. Soma das partes deve bater com 'valor'. Uso exclusivo do admin; nunca exposto ao cliente (RLS de campo abaixo). Quando ausente, o campo 'natureza' acima classifica o Billing inteiro.",
      "items": {
        "type": "object",
        "properties": {
          "natureza": {
            "type": "string",
            "enum": [
              "honorario",
              "intermediacao",
              "comissao",
              "repasse",
              "caucao"
            ]
          },
          "valor": {
            "type": "number"
          }
        }
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            }
          ]
        }
      }
    },
    "moeda": {
      "type": "string",
      "enum": [
        "BRL",
        "USD",
        "ARS"
      ],
      "default": "BRL",
      "description": "Moeda do contrato. BRL na esmagadora maioria dos casos."
    },
    "valor_original": {
      "type": "number",
      "description": "Valor na moeda original quando moeda != BRL (o campo 'valor' sempre fica em BRL, convertido pela taxa_cambio abaixo)."
    },
    "taxa_cambio": {
      "type": "number",
      "description": "Taxa de cambio usada para converter valor_original para BRL, quando aplicavel."
    },
    "data_cambio": {
      "type": "string",
      "format": "date",
      "description": "Data em que a taxa_cambio foi obtida/aplicada."
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "account_type": "equipe"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      }
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emissao/assinatura do contrato ou da cobranca (ex.: data do Adendo assinado) - usada para o KPI de Faturado do Mes (competencia). Quando vazia, cai para created_date (data em que o registro foi lancado no sistema), que pode nao bater com quando o contrato foi de fato assinado."
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento efetivo"
    },
    "comprovante_url": {
      "type": "string",
      "description": "DEPRECATED, mantido só por compatibilidade com registros antigos e leitores legados — sempre espelha o último item de 'comprovantes' abaixo. Novos comprovantes devem ser gravados em 'comprovantes' (histórico), nunca só aqui, senão o anexo anterior se perde ao reenviar. URL da foto/comprovante desta cobrança (nota fiscal, orçamento, print de passagem, recibo de pagamento etc.) — visível para admin, equipe e para o cliente vinculado a esta cobrança.",
      "rls": {
        "update": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        }
      }
    },
    "comprovantes": {
      "type": "array",
      "description": "Histórico de todos os comprovantes/documentos anexados a esta cobrança (nota fiscal, orçamento, print de passagem, recibo de pagamento etc.), do mais antigo ao mais recente — cada reenvio (do cliente ou da equipe) vira um item NOVO nesta lista, nunca substitui um anterior. Visível para admin, equipe e para o cliente vinculado.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "enviado_por": {
            "type": "string",
            "enum": [
              "cliente",
              "equipe"
            ]
          },
          "enviado_em": {
            "type": "string",
            "description": "Data/hora ISO do envio."
          }
        }
      },
      "rls": {
        "update": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        }
      }
    },
    "ultima_edicao_por": {
      "type": "string",
      "enum": [
        "equipe",
        "cliente"
      ],
      "description": "Quem fez a ultima edicao visivel deste registro (ex: anexar comprovante) — usado so para destacar no painel do admin quando foi o proprio cliente, nunca para controle de acesso.",
      "rls": {
        "update": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        }
      }
    }
  },
  "required": [
    "client_nome",
    "valor",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "equipe"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.client_id": "{{user.data.client_id}}"
            },
            {
              "data.client_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.client_id": "{{user.data.client_id}}"
            },
            {
              "data.client_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
